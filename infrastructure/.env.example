# Copy this file to .env in the same folder and fill in real values.
# Never commit the real .env to source control.

DATABASE_NAME=student_manager
DATABASE_USERNAME=student_manager
DATABASE_PASSWORD=

# Generate with: openssl rand -base64 48
JWT_SECRET=

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Comma-separated list of origins allowed to call this API (your mobile
# app's dev server, a web build, etc).
CORS_ALLOWED_ORIGINS=http://localhost:3000
